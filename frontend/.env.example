# Demo Mode: authenticated users can use every implemented feature, whatever
# their plan. Set to "false" to restore the original plan restrictions.
VITE_BYPASS_PLAN_RESTRICTIONS=true

# Offline sample-data demo (mocked API). Keep it "false" to demo the real
# backend; "true" replaces uploads/AI generation with local sample data.
VITE_DEMO_MODE=false

# Only needed when the API is not on http://localhost:5000/api
# VITE_API_BASE_URL=http://localhost:5000/api